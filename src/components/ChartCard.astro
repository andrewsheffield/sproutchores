---
import { iconSvg } from '../lib/chore-icons'
import { categoryColor } from '../lib/category-color'

interface Props {
  slug: string
  title: string
  label: string
  categoryId?: string | null
  hasImage?: boolean
}
const { slug, title, label, categoryId = null, hasImage = true } = Astro.props
const color = categoryColor(categoryId)
const alt = `${title} preview`
---
<a class="card" href={`/${slug}/`} style={`--ink:${color.ink};--fill:${color.fill}`}>
  <div class="card__media">
    {hasImage ? (
      <img src={`/charts/${slug}.png`} alt={alt} width="1650" height="1275" loading="lazy" decoding="async" />
    ) : (
      <span class="card__fallback" aria-hidden="true" set:html={iconSvg('sparkles')} />
    )}
  </div>
  <span class="card__label">{label}</span>
  <span class="card__title">{title}</span>
</a>
<style>
  .card {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-top: 3px solid var(--ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .15s ease, transform .15s ease;
  }
  .card:hover, .card:focus-visible { box-shadow: var(--shadow-md); transform: translateY(-2px); outline: none; }
  .card:focus-visible { box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring-color); }
  .card__media { aspect-ratio: 1650 / 1275; background: var(--fill); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card__fallback {
    width: 100%; height: 100%; display: grid; place-items: center; color: var(--ink);
  }
  .card__fallback :global(svg) { width: 33%; height: 33%; }
  .card__label {
    margin-top: var(--space-2); padding-inline: var(--space-3);
    font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: .04em; color: var(--ink);
  }
  .card__title {
    padding-inline: var(--space-3); padding-bottom: var(--space-3);
    font-family: var(--font-display); font-weight: var(--weight-bold); line-height: 1.2;
  }
</style>
