---
// Breadcrumbs: Home › {Category} › {Page} + BreadcrumbList JSON-LD.
// The category segment links to its hub route when one exists; otherwise it
// renders as plain text (no broken link). Tokens-only.
import { categoryMeta } from '../data/categories'

export interface Props {
  /** Category id from the entry (may be null). */
  category?: string | null
  /** Whether the category hub is live (published + enough members). Off = render
   *  the category as plain text, never a broken link. */
  categoryLive?: boolean
  /** Current page title (the leaf crumb). */
  title: string
}

const { category, categoryLive = false, title } = Astro.props
const cat = categoryMeta(category)

const site = Astro.site?.href.replace(/\/$/, '') ?? ''
const catHref = categoryLive && cat?.hubSlug ? `/${cat.hubSlug}/` : undefined

// Visible trail. The leaf (current page) is never a link.
const trail: Array<{ label: string; href?: string }> = [
  { label: 'Home', href: '/' },
  ...(cat ? [{ label: cat.label, href: catHref }] : []),
  { label: title },
]

// BreadcrumbList JSON-LD — only items that resolve to a URL get an `item`.
const itemList = trail.map((c, i) => {
  const node: Record<string, unknown> = { '@type': 'ListItem', position: i + 1, name: c.label }
  if (c.href) node.item = `${site}${c.href}`
  return node
})
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: itemList,
}
const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list" role="list">
    {trail.map((crumb, i) => {
      const isLast = i === trail.length - 1
      return (
        <li class="breadcrumbs__item">
          {crumb.href ? (
            <a class="breadcrumbs__link" href={crumb.href}>{crumb.label}</a>
          ) : isLast ? (
            <span class="breadcrumbs__current" aria-current="page">{crumb.label}</span>
          ) : (
            <span class="breadcrumbs__text">{crumb.label}</span>
          )}
          {!isLast && <span class="breadcrumbs__sep" aria-hidden="true">›</span>}
        </li>
      )
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={jsonLdSafe} />

<style>
  .breadcrumbs {
    max-width: var(--measure);
  }
  .breadcrumbs__list {
    list-style: none;
    margin: var(--space-0);
    padding: var(--space-0);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .breadcrumbs__link {
    color: var(--color-muted);
    text-decoration: none;
  }
  .breadcrumbs__link:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }
  .breadcrumbs__current {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .breadcrumbs__text {
    color: var(--color-muted);
  }
  .breadcrumbs__sep {
    color: var(--color-border);
  }
</style>
