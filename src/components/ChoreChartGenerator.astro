---
// ChoreChartGenerator.astro — interactive chore-chart generator island.
// All chart/chore logic is delegated to the tested core modules; the island
// script handles only DOM wiring, event handling, and metrics calls.
//
// No UI framework; vanilla TS in the <script> block so Astro bundles it as a
// small island chunk (CWV-safe).
//
// SEO / progressive enhancement: the DEFAULT age-6 chart is rendered server-
// side here so the primary content (the chart) is in the static HTML for
// crawlers and no-JS users. The client island re-renders the same structure
// on first paint and on every interaction — see renderTable() below.
import { chartForAge } from '../lib/generator-core'
import { buildPrintableChartModel } from '../lib/printable-chart'
import { choreIconSvg, iconSvg } from '../lib/chore-icons'

export interface Props {
  /** Representative age the chart starts on. Clamped to the supported range. */
  age?: number
}

// Default age 6 keeps existing behaviour; pages pass their own age. The supported
// dataset range is 2–17, so clamp to avoid an out-of-band initial render.
const SUPPORTED_MIN = 2
const SUPPORTED_MAX = 17
const { age = 6 } = Astro.props
const initialAge = Math.min(SUPPORTED_MAX, Math.max(SUPPORTED_MIN, Math.round(age)))

const initialModel = buildPrintableChartModel({ ...chartForAge(initialAge), childName: undefined })
// Suggestions for the add-row datalist: the current age band's default chores.
const initialSuggestions = chartForAge(initialAge).chores.map((c) => c.label)
// Day columns + a trailing remove-action column. The remove header is visually
// hidden (the per-row buttons carry their own labels) but keeps the grid square.
const dayColumns = initialModel.columns.slice(1)
---

<section class="generator" aria-label="Chore Chart Generator">
  <div class="generator__controls">

    <div class="control-row">
      <label class="control-label" for="ccg-age">Child's age</label>
      <input
        class="control-input control-input--number"
        id="ccg-age"
        type="number"
        min="2"
        max="17"
        value={initialAge}
        aria-describedby="ccg-age-hint"
      />
      <span id="ccg-age-hint" class="control-hint">Ages 2–17 supported</span>
    </div>

    <div class="control-row">
      <label class="control-label" for="ccg-name">Child's name <span class="control-optional">(optional)</span></label>
      <input
        class="control-input"
        id="ccg-name"
        type="text"
        placeholder="e.g. Sam"
        autocomplete="off"
        maxlength="40"
      />
    </div>

  </div>

  <!-- Live chart preview = the SINGLE editable surface -------------------- -->
  <!-- The default age-6 chart is server-rendered here for SEO / no-JS users.
       The island script (renderTable) replaces this with an identical table on
       first paint and re-renders it on every interaction. Each row is editable:
       a per-row remove button; an add-a-chore row lives in the table footer.
       Per-chore icons are inlined from chore-icons.ts so SSR and the island
       markup match exactly. -->
  <div class="generator__preview" id="ccg-preview" aria-live="polite">

    <!-- Caption is a real heading ABOVE the scroll area so it gets full width
         and never collides with / wraps into the colored header band. -->
    <div class="chart-title" id="ccg-chart-title">
      <span class="chart-title__icon" set:html={iconSvg('calendar-check')} />
      <span class="chart-title__text">{initialModel.title}</span>
    </div>

    <!-- Horizontal-scroll wrapper: on narrow screens the 7-day grid scrolls
         instead of crushing; the chore column is sticky so labels stay put. -->
    <div class="chart-scroll">
      <table class="chart-table" role="table" aria-label={initialModel.title}>
        <thead>
          <tr>
            <th scope="col" class="chart-table__th chart-table__th--chore">Chore</th>
            {dayColumns.map((col) => (
              <th scope="col" class="chart-table__th chart-table__th--day">{col}</th>
            ))}
            <th scope="col" class="chart-table__th chart-table__th--action">
              <span class="sr-only">Remove</span>
            </th>
          </tr>
        </thead>
        <tbody id="ccg-chart-body">
          {initialModel.rows.map((row) => (
            <tr class="chart-table__row">
              <td class="chart-table__chore">
                <div class="chart-table__chore-cell-inner">
                  <span class="chart-table__chore-icon" set:html={choreIconSvg(row.id, row.chore)} />
                  <span class="chart-table__chore-label">{row.chore}</span>
                </div>
              </td>
              {dayColumns.map((day) => (
                <td class="chart-table__check-cell">
                  <input
                    type="checkbox"
                    class="chart-table__checkbox"
                    aria-label={`${row.chore} — ${day}`}
                  />
                </td>
              ))}
              <td class="chart-table__action-cell">
                <button
                  class="btn chart-table__remove"
                  type="button"
                  aria-label={`Remove ${row.chore}`}
                >
                  <span class="chart-table__remove-icon" set:html={iconSvg('trash-2')} />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Add-a-chore row lives OUTSIDE the scroll area so it's always full-width
         and never squished. The leading + reads as an icon inside one cohesive
         field; the real action is the "Add chore" button. -->
    <div class="chart-add" id="ccg-add-row">
      <label class="sr-only" for="ccg-new-chore">Add a chore</label>
      <div class="chart-add__field">
        <span class="chart-add__icon" set:html={iconSvg('plus')} />
        <input
          class="chart-add__input"
          id="ccg-new-chore"
          type="text"
          placeholder="Type a chore and press Enter…"
          maxlength="60"
          autocomplete="off"
          list="ccg-chore-suggestions"
          aria-describedby="ccg-new-chore-hint"
        />
        <button class="btn btn--secondary chart-add__btn" id="ccg-add-btn" type="button">
          Add chore
        </button>
      </div>
      <span id="ccg-new-chore-hint" class="control-hint">
        Pick a suggestion or type your own — Enter adds it to the chart.
      </span>
    </div>

    <datalist id="ccg-chore-suggestions">
      {initialSuggestions.map((s) => <option value={s}></option>)}
    </datalist>
  </div>

  <!-- Visually-hidden live region: announces add / remove for screen readers -->
  <div class="sr-only" id="ccg-live" aria-live="polite" role="status"></div>

  <!-- Print action -------------------------------------------------------- -->
  <div class="generator__actions">
    <button class="btn btn--primary btn--large" id="ccg-print-btn" type="button">
      <span class="btn__icon" set:html={iconSvg('printer')} />
      <span>Print / Save as PDF</span>
    </button>
  </div>
</section>

<!-- =========================================================================
     Island script — vanilla TS, bundled by Astro/Vite.
     Imports the tested cores; NO business logic re-implemented here.
========================================================================== -->
<script>
  import { chartForAge } from '../lib/generator-core'
  import { buildPrintableChartModel } from '../lib/printable-chart'
  import { createMetrics, gaSend, EVENTS } from '../lib/metrics'
  import { getVariant } from '../lib/variant-config'
  import { choreIconSvg, iconSvg } from '../lib/chore-icons'

  // ---- Metrics setup -------------------------------------------------------
  const metrics = createMetrics({
    send: gaSend(import.meta.env.PUBLIC_GA4_ID),
    getVariant,
  })
  // GENERATOR_START and GENERATOR_COMPLETE are one-shot funnel events. START
  // fires on the first real interaction; COMPLETE fires once, only after START,
  // when a valid (non-empty) chart is shown — never from the initial load.
  let startFired = false
  let completeFired = false

  function trackStart() {
    if (!startFired) {
      startFired = true
      metrics.track(EVENTS.GENERATOR_START)
    }
  }

  function maybeTrackComplete(choreCount: number) {
    if (startFired && !completeFired && choreCount > 0) {
      completeFired = true
      metrics.track(EVENTS.GENERATOR_COMPLETE, { age: currentAge })
    }
  }

  // ---- DOM refs ------------------------------------------------------------
  // The chart is the single editable surface: rows live in #ccg-chart-body
  // (rebuilt on chore/age changes); the add-row input + datalist are static so
  // focus survives rapid multi-add. The caption text node updates in place.
  const ageInput    = document.getElementById('ccg-age')    as HTMLInputElement
  const nameInput   = document.getElementById('ccg-name')   as HTMLInputElement
  const preview     = document.getElementById('ccg-preview')!
  const chartBody   = document.getElementById('ccg-chart-body')!
  const newChoreIn  = document.getElementById('ccg-new-chore') as HTMLInputElement
  const addBtn      = document.getElementById('ccg-add-btn')!
  const printBtn    = document.getElementById('ccg-print-btn')!
  const liveRegion  = document.getElementById('ccg-live')!
  const suggestions = document.getElementById('ccg-chore-suggestions')!

  // ---- State ---------------------------------------------------------------
  // `customChores` starts as null (= use band defaults). Once the user edits
  // the list it becomes the overridden set so changes survive name edits
  // (an age change resets it back to the new band's defaults).
  type ChoreItem = { id: string; label: string }
  const AGE_MIN = 2
  const AGE_MAX = 17
  // Seeded from the SSR'd age input on init (below) so the island doesn't reset
  // an age-N page back to 6 on hydration.
  let currentAge   = 6
  let customChores: ChoreItem[] | null = null
  let customChoreSeq = 0 // monotonic counter for collision-free custom ids

  // ---- Core helpers --------------------------------------------------------
  function getEffectiveChores(): ChoreItem[] {
    if (customChores !== null) return customChores
    const { chores } = chartForAge(currentAge)
    return chores
  }

  function getEffectiveAgeBand(): string {
    return chartForAge(currentAge).ageBand
  }

  function currentTitle(): string {
    const childName = nameInput.value.trim() || undefined
    return buildPrintableChartModel({
      ageBand: getEffectiveAgeBand(),
      chores: getEffectiveChores(),
      childName,
    }).title
  }

  // Announce an action to assistive tech via the polite live region.
  function announce(message: string) {
    liveRegion.textContent = message
  }

  // After a remove, move focus to the next row's remove button, else the
  // previous row's, else the add input — never drop focus to <body>.
  function focusAfterRemove(removedIndex: number, rowCount: number) {
    const buttons = chartBody.querySelectorAll<HTMLButtonElement>('.chart-table__remove')
    let target: HTMLElement | null = null
    if (buttons.length > 0) {
      const next = buttons[Math.min(removedIndex, buttons.length - 1)]
      target = next ?? buttons[buttons.length - 1] ?? null
    }
    ;(target ?? newChoreIn).focus()
  }

  function removeChore(id: string, label: string, index: number) {
    trackStart()
    if (customChores === null) {
      customChores = getEffectiveChores().slice()
    }
    customChores = customChores.filter((c) => c.id !== id)
    const remaining = customChores.length
    renderChartBody()
    announce(`${label} removed`)
    focusAfterRemove(index, remaining)
  }

  // ---- Render the editable chart body (rows) -------------------------------
  // Rebuilds ONLY #ccg-chart-body so the static thead/tfoot (add input) keep
  // their identity and focus. The caption text is refreshed in place.
  function renderChartBody() {
    const chores  = getEffectiveChores()
    const ageBand = getEffectiveAgeBand()
    const childName = nameInput.value.trim() || undefined
    const model = buildPrintableChartModel({ ageBand, chores, childName })
    const dayColumns = model.columns.slice(1)

    updateTitle(model.title)

    chartBody.innerHTML = ''

    if (model.rows.length === 0) {
      const emptyRow = document.createElement('tr')
      const emptyCell = document.createElement('td')
      emptyCell.colSpan = dayColumns.length + 2 // chore + days + action
      emptyCell.className = 'chart-table__empty'
      emptyCell.textContent = 'No chores yet — add one below.'
      emptyRow.appendChild(emptyCell)
      chartBody.appendChild(emptyRow)
    } else {
      model.rows.forEach((row, index) => {
        const tr = document.createElement('tr')
        tr.className = 'chart-table__row'

        // Chore cell: icon + label (wrapped so they share a flex gap).
        const choreCell = document.createElement('td')
        choreCell.className = 'chart-table__chore'
        const choreInner = document.createElement('div')
        choreInner.className = 'chart-table__chore-cell-inner'
        const choreIcon = document.createElement('span')
        choreIcon.className = 'chart-table__chore-icon'
        choreIcon.innerHTML = choreIconSvg(row.id, row.chore)
        const choreLabel = document.createElement('span')
        choreLabel.className = 'chart-table__chore-label'
        choreLabel.textContent = row.chore
        choreInner.appendChild(choreIcon)
        choreInner.appendChild(choreLabel)
        choreCell.appendChild(choreInner)
        tr.appendChild(choreCell)

        // Day checkbox cells (one per day column).
        dayColumns.forEach((day) => {
          const td = document.createElement('td')
          td.className = 'chart-table__check-cell'
          const cb = document.createElement('input')
          cb.type = 'checkbox'
          cb.className = 'chart-table__checkbox'
          cb.setAttribute('aria-label', `${row.chore} — ${day}`)
          td.appendChild(cb)
          tr.appendChild(td)
        })

        // Trailing remove-action cell — a real <button> with a trash icon and
        // an aria-label; the icon is decorative (aria-hidden via iconSvg).
        const actionCell = document.createElement('td')
        actionCell.className = 'chart-table__action-cell'
        const removeBtn = document.createElement('button')
        removeBtn.type = 'button'
        removeBtn.className = 'btn chart-table__remove'
        removeBtn.setAttribute('aria-label', `Remove ${row.chore}`)
        removeBtn.innerHTML = iconSvg('trash-2', 'chart-table__remove-icon')
        removeBtn.addEventListener('click', () => removeChore(row.id, row.chore, index))
        actionCell.appendChild(removeBtn)
        tr.appendChild(actionCell)

        chartBody.appendChild(tr)
      })
    }

    // Keep suggestions in sync: only offer chores not already on the chart.
    refreshSuggestions()

    maybeTrackComplete(chores.length)
  }

  // ---- Render: title-only update (name changes) ----------------------------
  // Updates the caption text + the table's aria-label without touching rows,
  // preserving ticked checkboxes and the caption icon.
  function updateTitle(title = currentTitle()) {
    const titleText = document.querySelector('#ccg-chart-title .chart-title__text')
    const table = preview.querySelector('table')
    if (titleText) titleText.textContent = title
    if (table) table.setAttribute('aria-label', title)
  }

  // ---- Refresh the suggestion datalist -------------------------------------
  // Pool = the current age band's default chores; EXCLUDE any already on the
  // chart (case-insensitive, trimmed) so the dropdown only offers not-yet-added
  // options. Called from renderChartBody() so it stays in sync on add/remove/
  // age change.
  function refreshSuggestions() {
    const present = new Set(getEffectiveChores().map((c) => c.label.trim().toLowerCase()))
    const pool = chartForAge(currentAge).chores.map((c) => c.label)
    suggestions.innerHTML = ''
    pool
      .filter((label) => !present.has(label.trim().toLowerCase()))
      .forEach((label) => {
        const opt = document.createElement('option')
        opt.value = label
        suggestions.appendChild(opt)
      })
  }

  // ---- Event: age change ---------------------------------------------------
  ageInput.addEventListener('input', () => {
    trackStart()
    const parsed = parseInt(ageInput.value, 10)
    if (!Number.isFinite(parsed)) return
    // Clamp to the supported range and reflect the clamped value back into the
    // input so the title's band and the input value never disagree.
    const clamped = Math.min(AGE_MAX, Math.max(AGE_MIN, parsed))
    if (String(clamped) !== ageInput.value) ageInput.value = String(clamped)
    currentAge = clamped
    // Reset custom chores on age change so defaults for the new band apply.
    customChores = null
    renderChartBody()
  })

  // ---- Event: name change (title only — no row rebuild) --------------------
  nameInput.addEventListener('input', () => {
    trackStart()
    updateTitle()
  })

  // ---- Event: add chore ----------------------------------------------------
  function addChore() {
    const label = newChoreIn.value.trim()
    if (!label) return
    trackStart()
    if (customChores === null) {
      customChores = getEffectiveChores().slice()
    }
    // Block duplicates (case-insensitive, trimmed): no-op, clear, announce.
    const exists = customChores.some(
      (c) => c.label.trim().toLowerCase() === label.toLowerCase(),
    )
    if (exists) {
      newChoreIn.value = ''
      announce(`${label} is already on the chart`)
      newChoreIn.focus()
      return
    }
    const id = `custom-${++customChoreSeq}`
    customChores = [...customChores, { id, label }]
    newChoreIn.value = ''
    renderChartBody()
    announce(`${label} added`)
    // Keep focus in the input for rapid multi-add.
    newChoreIn.focus()
  }

  addBtn.addEventListener('click', addChore)
  newChoreIn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault()
      addChore()
    }
  })

  // ---- Event: print button -------------------------------------------------
  printBtn.addEventListener('click', () => {
    metrics.track(EVENTS.PDF_DOWNLOAD, { age: currentAge })
    window.print()
  })

  // ---- Initial render ------------------------------------------------------
  // Seed currentAge from the SSR'd input value (each page sets its own age) so
  // hydration preserves the rendered age instead of snapping back to 6.
  const seededAge = parseInt(ageInput.value, 10)
  if (Number.isFinite(seededAge)) {
    currentAge = Math.min(AGE_MAX, Math.max(AGE_MIN, seededAge))
  }
  // Renders the default chart WITHOUT firing GENERATOR_COMPLETE (no interaction
  // yet): maybeTrackComplete() is guarded by startFired, which is still false.
  // renderChartBody() also builds the initial (exclusion-aware) datalist.
  renderChartBody()

</script>

<style is:global>
  /* GLOBAL (not scoped): the island rebuilds the chart rows/checkboxes/chips in
     JS via createElement, and Astro's scoped data-astro-cid attribute is only on
     build-time template elements — scoped rules never reach the hydrated DOM.
     These class names are namespaced (chart-, chore-item, generator-) so global
     scope is safe and is the only thing that styles the dynamic elements. */
  /* =========================================================================
     Generator island — tokens only; NO hardcoded hex/rgb/px.

     The chart is the single editable surface: each row has a remove button and
     an add-a-chore row lives in the table footer. The live theme is `modern`
     (set via <html data-theme="modern"> by getVariant()); its palette, type and
     radius come from tokens.css, so this file styles structure only.
  ========================================================================= */

  /* ---- Inline icons (build-time SVG, currentColor) ---------------------- */
  .icon {
    width: var(--icon-size, var(--space-5));
    height: var(--icon-size, var(--space-5));
    display: block;
    color: currentColor;
  }
  /* set:html wrappers shouldn't add baseline wobble. */
  .btn__icon,
  .chart-title__icon,
  .chart-table__chore-icon,
  .chart-table__remove-icon,
  .chart-add__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .generator {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-6);
  }

  /* ---- Controls --------------------------------------------------------- */

  .generator__controls {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
  }

  /* Side-by-side on wider cards; stacks naturally on narrow screens. */
  @media (min-width: 30rem) {
    .generator__controls {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }

  .control-row {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .control-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .control-optional {
    font-weight: var(--weight-normal);
    color: var(--color-muted);
  }

  .control-hint {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .control-input {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .control-input::placeholder {
    color: var(--color-muted);
  }

  .control-input:focus-visible {
    border-color: var(--color-primary);
    outline: none;
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring-color);
  }

  .control-input--number {
    max-width: var(--space-8);
    text-align: center;
    font-weight: var(--weight-medium);
  }

  /* ---- Preview area ----------------------------------------------------- */

  .generator__preview {
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: var(--space-4);
    /* Reserve vertical space so the initial chart render doesn't shift layout. */
    min-height: var(--space-9);
  }

  /* Caption as a real heading — full width, its own line, above the band. */
  .chart-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-0);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .chart-title__icon {
    color: var(--color-primary);
    --icon-size: var(--space-6);
  }

  /* Horizontal-scroll wrapper — the grid scrolls on mobile instead of crushing. */
  .chart-scroll {
    overflow-x: auto;
    border-radius: var(--radius-md);
    /* Smooth, contained momentum scroll on touch. */
    -webkit-overflow-scrolling: touch;
  }

  .chart-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--text-sm);
    /* Enough room for the icon+label column, 7 legible day boxes, and remove.
       Below this width the .chart-scroll wrapper scrolls horizontally. */
    min-width: var(--chart-min-width);
  }

  /* Colored header band — a solid brand strip (modern: crisp, not uppercased). */
  .chart-table__th {
    padding: var(--space-3) var(--space-2);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-primary-contrast);
    background-color: var(--color-primary);
    white-space: nowrap;
  }

  /* Rounded header ends for a friendly chart-card look. */
  .chart-table__th:first-child {
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
  }

  .chart-table__th:last-child {
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  /* Chore (first) column: sticky so labels stay visible while days scroll. */
  .chart-table__th--chore,
  .chart-table__chore {
    position: sticky;
    left: 0;
    z-index: 1;
  }

  .chart-table__th--chore {
    text-align: left;
    padding-left: var(--space-4);
    width: var(--chart-chore-col);
    min-width: var(--chart-chore-col);
  }

  /* Fixed, comfortable day-column width so Mon–Sun stay even and legible. */
  .chart-table__th--day,
  .chart-table__check-cell {
    width: var(--chart-day-col);
    min-width: var(--chart-day-col);
  }

  /* Trailing remove-action column — narrow, fixed. */
  .chart-table__th--action,
  .chart-table__action-cell {
    width: var(--space-8);
    min-width: var(--space-8);
    text-align: center;
  }

  /* Gentle separation; modern = flat (no row tints). */
  .chart-table__row .chart-table__chore,
  .chart-table__row .chart-table__check-cell,
  .chart-table__row .chart-table__action-cell {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .chart-table__chore {
    padding: var(--space-2) var(--space-4);
    /* Sticky column needs an opaque background so scrolling days pass behind. */
    background-color: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-medium);
