---
// ChoreChartGenerator.astro — interactive chore-chart generator island.
// All chart/chore logic is delegated to the tested core modules; the island
// script handles only DOM wiring, event handling, and metrics calls.
//
// No UI framework; vanilla TS in the <script> block so Astro bundles it as a
// small island chunk (CWV-safe).
//
// SEO / progressive enhancement: the DEFAULT age-6 chart is rendered server-
// side here so the primary content (the chart) is in the static HTML for
// crawlers and no-JS users. The client island re-renders the same structure
// on first paint and on every interaction — see renderTable() below.
import { chartForAge } from '../lib/generator-core'
import { buildPrintableChartModel } from '../lib/printable-chart'
import { choreIconSvg, iconSvg } from '../lib/chore-icons'

const initialModel = buildPrintableChartModel({ ...chartForAge(6), childName: undefined })
---

<section class="generator" aria-label="Chore Chart Generator">
  <div class="generator__controls">

    <div class="control-row">
      <label class="control-label" for="ccg-age">Child's age</label>
      <input
        class="control-input control-input--number"
        id="ccg-age"
        type="number"
        min="4"
        max="9"
        value="6"
        aria-describedby="ccg-age-hint"
      />
      <span id="ccg-age-hint" class="control-hint">Ages 4–9 supported</span>
    </div>

    <div class="control-row">
      <label class="control-label" for="ccg-name">Child's name <span class="control-optional">(optional)</span></label>
      <input
        class="control-input"
        id="ccg-name"
        type="text"
        placeholder="e.g. Sam"
        autocomplete="off"
        maxlength="40"
      />
    </div>

  </div>

  <!-- Live chart preview -------------------------------------------------- -->
  <!-- The default age-6 chart is server-rendered here for SEO / no-JS users.
       The island script (renderTable) replaces this with an identical table on
       first paint and re-renders it on every interaction. Per-chore icons are
       inlined from chore-icons.ts so SSR and the island markup match exactly. -->
  <div class="generator__preview" id="ccg-preview" aria-live="polite">
    <table class="chart-table" role="table" aria-label={initialModel.title}>
      <caption class="chart-table__title" id="ccg-chart-title">
        <span class="chart-table__title-icon" set:html={iconSvg('calendar-check')} />
        <span class="chart-table__title-text">{initialModel.title}</span>
      </caption>
      <thead>
        <tr>
          {initialModel.columns.map((col) => (
            <th
              scope="col"
              class={col === 'Chore'
                ? 'chart-table__th chart-table__th--chore'
                : 'chart-table__th chart-table__th--day'}
            >{col}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {initialModel.rows.map((row) => (
          <tr class="chart-table__row">
            <td class="chart-table__chore">
              <span class="chart-table__chore-icon" set:html={choreIconSvg(row.id)} />
              <span class="chart-table__chore-label">{row.chore}</span>
            </td>
            {initialModel.columns.slice(1).map((day) => (
              <td class="chart-table__check-cell">
                <input
                  type="checkbox"
                  class="chart-table__checkbox"
                  aria-label={`${row.chore} — ${day}`}
                />
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Chore management ---------------------------------------------------- -->
  <div class="generator__chore-editor" id="ccg-chore-editor" aria-label="Edit chores">
    <h3 class="chore-editor__heading">Chores on this chart</h3>
    <ul class="chore-list" id="ccg-chore-list" role="list">
      <!-- Populated by island script -->
    </ul>
    <div class="chore-add-row">
      <label class="control-label" for="ccg-new-chore">Add a chore</label>
      <div class="chore-add-row__inputs">
        <input
          class="control-input chore-add-row__text"
          id="ccg-new-chore"
          type="text"
          placeholder="e.g. Take out recycling"
          maxlength="60"
          aria-describedby="ccg-new-chore-hint"
        />
        <button class="btn btn--secondary" id="ccg-add-btn" type="button">
          <span class="btn__icon" set:html={iconSvg('plus')} />
          <span>Add</span>
        </button>
      </div>
      <span id="ccg-new-chore-hint" class="control-hint">Press Add or Enter to add to the chart</span>
    </div>
  </div>

  <!-- Print action -------------------------------------------------------- -->
  <div class="generator__actions">
    <button class="btn btn--primary btn--large" id="ccg-print-btn" type="button">
      <span class="btn__icon" set:html={iconSvg('printer')} />
      <span>Print / Save as PDF</span>
    </button>
  </div>
</section>

<!-- =========================================================================
     Island script — vanilla TS, bundled by Astro/Vite.
     Imports the tested cores; NO business logic re-implemented here.
========================================================================== -->
<script>
  import { chartForAge } from '../lib/generator-core'
  import { buildPrintableChartModel } from '../lib/printable-chart'
  import { createMetrics, gaSend, EVENTS } from '../lib/metrics'
  import { getVariant } from '../lib/variant-config'
  import { choreIconSvg, iconSvg } from '../lib/chore-icons'

  // ---- Metrics setup -------------------------------------------------------
  const metrics = createMetrics({
    send: gaSend(import.meta.env.PUBLIC_GA4_ID),
    getVariant,
  })
  // GENERATOR_START and GENERATOR_COMPLETE are one-shot funnel events. START
  // fires on the first real interaction; COMPLETE fires once, only after START,
  // when a valid (non-empty) chart is shown — never from the initial load.
  let startFired = false
  let completeFired = false

  function trackStart() {
    if (!startFired) {
      startFired = true
      metrics.track(EVENTS.GENERATOR_START)
    }
  }

  function maybeTrackComplete(choreCount: number) {
    if (startFired && !completeFired && choreCount > 0) {
      completeFired = true
      metrics.track(EVENTS.GENERATOR_COMPLETE, { age: currentAge })
    }
  }

  // ---- DOM refs ------------------------------------------------------------
  const ageInput    = document.getElementById('ccg-age')    as HTMLInputElement
  const nameInput   = document.getElementById('ccg-name')   as HTMLInputElement
  const preview     = document.getElementById('ccg-preview')!
  const choreList   = document.getElementById('ccg-chore-list')!
  const newChoreIn  = document.getElementById('ccg-new-chore') as HTMLInputElement
  const addBtn      = document.getElementById('ccg-add-btn')!
  const printBtn    = document.getElementById('ccg-print-btn')!

  // ---- State ---------------------------------------------------------------
  // `customChores` starts as null (= use band defaults). Once the user edits
  // the list it becomes the overridden set so changes survive name edits
  // (an age change resets it back to the new band's defaults).
  type ChoreItem = { id: string; label: string }
  const AGE_MIN = 4
  const AGE_MAX = 9
  let currentAge   = 6
  let customChores: ChoreItem[] | null = null
  let customChoreSeq = 0 // monotonic counter for collision-free custom ids

  // ---- Core helpers --------------------------------------------------------
  function getEffectiveChores(): ChoreItem[] {
    if (customChores !== null) return customChores
    const { chores } = chartForAge(currentAge)
    return chores
  }

  function getEffectiveAgeBand(): string {
    return chartForAge(currentAge).ageBand
  }

  function currentTitle(): string {
    const childName = nameInput.value.trim() || undefined
    return buildPrintableChartModel({
      ageBand: getEffectiveAgeBand(),
      chores: getEffectiveChores(),
      childName,
    }).title
  }

  // ---- Render: full table rebuild (age / chore-set changes only) -----------
  function renderTable() {
    const chores  = getEffectiveChores()
    const ageBand = getEffectiveAgeBand()
    const childName = nameInput.value.trim() || undefined

    const model = buildPrintableChartModel({ ageBand, chores, childName })

    const table = document.createElement('table')
    table.className = 'chart-table'
    table.setAttribute('role', 'table')
    table.setAttribute('aria-label', model.title)

    // Caption (also the visible title for print). Tagged so a name-only change
    // can update just this node without rebuilding the table. The leading icon
    // matches the SSR caption markup; the title text lives in its own span so
    // updateTitle() can swap just the text without disturbing the icon.
    const caption = document.createElement('caption')
    caption.className = 'chart-table__title'
    caption.id = 'ccg-chart-title'
    const captionIcon = document.createElement('span')
    captionIcon.className = 'chart-table__title-icon'
    captionIcon.innerHTML = iconSvg('calendar-check')
    const captionText = document.createElement('span')
    captionText.className = 'chart-table__title-text'
    captionText.textContent = model.title
    caption.appendChild(captionIcon)
    caption.appendChild(captionText)
    table.appendChild(caption)

    // Header row
    const thead = document.createElement('thead')
    const headerRow = document.createElement('tr')
    model.columns.forEach((col) => {
      const th = document.createElement('th')
      th.scope = 'col'
      th.className = col === 'Chore' ? 'chart-table__th chart-table__th--chore' : 'chart-table__th chart-table__th--day'
      th.textContent = col
      headerRow.appendChild(th)
    })
    thead.appendChild(headerRow)
    table.appendChild(thead)

    // Body rows — one per chore
    const tbody = document.createElement('tbody')
    if (model.rows.length === 0) {
      const emptyRow = document.createElement('tr')
      const emptyCell = document.createElement('td')
      emptyCell.colSpan = model.columns.length
      emptyCell.className = 'chart-table__empty'
      emptyCell.textContent = 'No chores on this chart yet — add some below.'
      emptyRow.appendChild(emptyCell)
      tbody.appendChild(emptyRow)
    } else {
      model.rows.forEach((row) => {
        const tr = document.createElement('tr')
        tr.className = 'chart-table__row'

        const choreCell = document.createElement('td')
        choreCell.className = 'chart-table__chore'
        const choreIcon = document.createElement('span')
        choreIcon.className = 'chart-table__chore-icon'
        choreIcon.innerHTML = choreIconSvg(row.id)
        const choreLabel = document.createElement('span')
        choreLabel.className = 'chart-table__chore-label'
        choreLabel.textContent = row.chore
        choreCell.appendChild(choreIcon)
        choreCell.appendChild(choreLabel)
        tr.appendChild(choreCell)

        // Day checkbox cells (one per day column)
        model.columns.slice(1).forEach((day) => {
          const td = document.createElement('td')
          td.className = 'chart-table__check-cell'
          const cb = document.createElement('input')
          cb.type = 'checkbox'
          cb.className = 'chart-table__checkbox'
          cb.setAttribute('aria-label', `${row.chore} — ${day}`)
          td.appendChild(cb)
          tr.appendChild(td)
        })

        tbody.appendChild(tr)
      })
    }
    table.appendChild(tbody)

    preview.innerHTML = ''
    preview.appendChild(table)

    maybeTrackComplete(chores.length)
  }

  // ---- Render: title-only update (name changes) ----------------------------
  // Updates the caption text + the table's aria-label in place, preserving
  // ticked checkboxes and avoiding table churn. Falls back to a full rebuild
  // only if the table hasn't been rendered yet.
  function updateTitle() {
    const title = currentTitle()
    const caption = document.getElementById('ccg-chart-title')
    const titleText = caption?.querySelector('.chart-table__title-text')
    const table = preview.querySelector('table')
    if (caption && titleText && table) {
      titleText.textContent = title
      table.setAttribute('aria-label', title)
    } else {
      renderTable()
    }
  }

  // ---- Render chore editor list -------------------------------------------
  function renderChoreList() {
    const chores = getEffectiveChores()
    choreList.innerHTML = ''

    chores.forEach((chore) => {
      const li = document.createElement('li')
      li.className = 'chore-item'

      const icon = document.createElement('span')
      icon.className = 'chore-item__icon'
      icon.innerHTML = choreIconSvg(chore.id)

      const label = document.createElement('span')
      label.className = 'chore-item__label'
      label.textContent = chore.label

      const removeBtn = document.createElement('button')
      removeBtn.type = 'button'
      removeBtn.className = 'btn chore-item__remove'
      removeBtn.setAttribute('aria-label', `Remove "${chore.label}"`)
      // Icon-only remove button: the × glyph is an inline Lucide SVG (decorative,
      // aria-hidden); the accessible name comes from the aria-label above.
      removeBtn.innerHTML = iconSvg('x', 'chore-item__remove-icon')
      removeBtn.addEventListener('click', () => {
        trackStart()
        if (customChores === null) {
          customChores = getEffectiveChores().slice()
        }
        customChores = customChores.filter((c) => c.id !== chore.id)
        renderChoreSet()
      })

      li.appendChild(icon)
      li.appendChild(label)
      li.appendChild(removeBtn)
      choreList.appendChild(li)
    })
  }

  // ---- Refresh helpers -----------------------------------------------------
  // Chore-set or age change: rebuild both the editor list and the table.
  function renderChoreSet() {
    renderChoreList()
    renderTable()
  }

  // ---- Event: age change ---------------------------------------------------
  ageInput.addEventListener('input', () => {
    trackStart()
    const parsed = parseInt(ageInput.value, 10)
    if (!Number.isFinite(parsed)) return
    // Clamp to the supported range and reflect the clamped value back into the
    // input so the title's band and the input value never disagree.
    const clamped = Math.min(AGE_MAX, Math.max(AGE_MIN, parsed))
    if (String(clamped) !== ageInput.value) ageInput.value = String(clamped)
    currentAge = clamped
    // Reset custom chores on age change so defaults for the new band apply.
    customChores = null
    renderChoreSet()
  })

  // ---- Event: name change (title only — no table rebuild) ------------------
  nameInput.addEventListener('input', () => {
    trackStart()
    updateTitle()
  })

  // ---- Event: add chore ----------------------------------------------------
  function addChore() {
    const label = newChoreIn.value.trim()
    if (!label) return
    trackStart()
    if (customChores === null) {
      customChores = getEffectiveChores().slice()
    }
    const id = `custom-${++customChoreSeq}`
    customChores = [...customChores, { id, label }]
    newChoreIn.value = ''
    renderChoreSet()
  }

  addBtn.addEventListener('click', addChore)
  newChoreIn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault()
      addChore()
    }
  })

  // ---- Event: print button -------------------------------------------------
  printBtn.addEventListener('click', () => {
    metrics.track(EVENTS.PDF_DOWNLOAD, { age: currentAge })
    window.print()
  })

  // ---- Initial render ------------------------------------------------------
  // Renders the default chart WITHOUT firing GENERATOR_COMPLETE (no interaction
  // yet): maybeTrackComplete() is guarded by startFired, which is still false.
  renderChoreList()
  renderTable()

</script>

<style>
  /* =========================================================================
     Generator island — tokens only; NO hardcoded hex/rgb/px.

     Structure is shared across all themes; each :root[data-theme="..."] block
     below (sprout / playful / modern) re-skins it via tokens AND a few
     structural overrides so the directions feel genuinely distinct, not just
     recoloured. The `control` theme uses the base rules unchanged.
  ========================================================================= */

  /* ---- Inline icons (build-time SVG, currentColor) ---------------------- */
  .icon {
    width: var(--icon-size, var(--space-5));
    height: var(--icon-size, var(--space-5));
    display: block;
    color: currentColor;
  }
  /* set:html wrappers shouldn't add baseline wobble. */
  .btn__icon,
  .chart-table__title-icon,
  .chart-table__chore-icon,
  .chore-item__icon,
  .chore-item__remove-icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .generator {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-6);
  }

  /* ---- Controls --------------------------------------------------------- */

  .generator__controls {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
  }

  /* Side-by-side on wider cards; stacks naturally on narrow screens. */
  @media (min-width: 30rem) {
    .generator__controls {
      grid-template-columns: auto 1fr;
      align-items: start;
    }
  }

  .control-row {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .control-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .control-optional {
    font-weight: var(--weight-normal);
    color: var(--color-muted);
  }

  .control-hint {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .control-input {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .control-input::placeholder {
    color: var(--color-muted);
  }

  .control-input:focus-visible {
    border-color: var(--color-primary);
    outline: none;
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring-color);
  }

  .control-input--number {
    max-width: var(--space-8);
    text-align: center;
    font-weight: var(--weight-medium);
  }

  /* ---- Preview table ---------------------------------------------------- */

  .generator__preview {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    box-shadow: var(--shadow-sm);
    /* Reserve vertical space so the initial chart render doesn't shift layout. */
    min-height: var(--space-9);
  }

  .chart-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--text-sm);
    table-layout: fixed;
    /* Keep day columns tidy on desktop without crushing on mobile. */
    min-width: var(--space-9);
  }

  .chart-table__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    text-align: left;
    padding-bottom: var(--space-4);
    caption-side: top;
    line-height: var(--leading-snug);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .chart-table__title-icon {
    color: var(--color-primary);
    --icon-size: var(--space-6);
  }

  /* Colored header band — a solid sprout/brand-tinted strip, not a hairline. */
  .chart-table__th {
    padding: var(--space-3) var(--space-2);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-contrast);
    background-color: var(--color-primary);
    white-space: nowrap;
  }

  /* Rounded header ends for a friendly chart-card look. */
  .chart-table__th:first-child {
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
  }

  .chart-table__th:last-child {
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  .chart-table__th--chore {
    text-align: left;
    padding-left: var(--space-4);
    width: 40%;
  }

  /* Gentle separation + row tints — reads as a printable chart, not a sheet. */
  .chart-table__row .chart-table__chore,
  .chart-table__row .chart-table__check-cell {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .chart-table__row:nth-child(even) .chart-table__chore,
  .chart-table__row:nth-child(even) .chart-table__check-cell {
    background-color: var(--color-surface-sunken);
  }

  .chart-table__chore {
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    vertical-align: middle;
    line-height: var(--leading-snug);
  }

  .chart-table__chore-icon {
    --icon-size: var(--space-5);
    color: var(--color-primary);
    margin-right: var(--space-3);
    vertical-align: middle;
  }

  .chart-table__chore-label {
    vertical-align: middle;
  }

  .chart-table__check-cell {
    padding: var(--space-3) var(--space-2);
    text-align: center;
    vertical-align: middle;
  }

  /* Big friendly rounded tick-box — a real keyboard-operable checkbox styled
     via appearance:none + a CSS check glyph on :checked + a focus ring. */
  .chart-table__checkbox {
    appearance: none;
    -webkit-appearance: none;
    width: var(--space-6);
    height: var(--space-6);
    margin: var(--space-0);
    flex-shrink: 0;
    border: var(--border-checkbox) solid var(--color-primary);
    border-radius: var(--radius-md);
    background-color: var(--color-accent-soft);
    cursor: pointer;
    display: inline-grid;
    place-content: center;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  /* Check glyph drawn as a CSS tick (no asset); revealed on :checked. */
  .chart-table__checkbox::before {
    content: '';
    width: var(--space-2);
    height: var(--space-4);
    border: solid var(--color-primary-contrast);
    border-width: var(--border-checkmark);
    border-top: var(--space-0);
    border-left: var(--space-0);
    transform: rotate(40deg) scale(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .chart-table__checkbox:hover {
    background-color: var(--color-accent);
    transform: scale(1.05);
  }

  .chart-table__checkbox:checked {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .chart-table__checkbox:checked::before {
    transform: rotate(40deg) scale(1);
  }

  .chart-table__checkbox:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring-color);
  }

  .chart-table__empty {
    padding: var(--space-5);
    text-align: center;
    color: var(--color-muted);
    font-style: italic;
  }

  /* ---- Chore editor ------------------------------------------------------ */

  .generator__chore-editor {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
  }

  .chore-editor__heading {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: var(--space-0);
  }

  .chore-list {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Each chore is a rounded chip: icon + label + circular icon remove button. */
  .chore-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .chore-item:hover {
    border-color: var(--color-accent);
  }

  .chore-item__icon {
    --icon-size: var(--space-4);
    color: var(--color-primary);
  }

  .chore-item__label {
    font-size: var(--text-sm);
