---
// Crawlable, on-page preview of the page's printable chart (the PNG that the build
// renders to /charts/<slug>.png). Print-hidden so it never double-prints over the
// interactive generator. Explicit width/height avoid layout shift.
interface Props {
  slug: string
  alt: string
  caption?: string
}
const { slug, alt, caption } = Astro.props
---
<figure class="chart-image">
  <img src={`/charts/${slug}.png`} alt={alt} width="1650" height="1275" loading="eager" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  /* Hero preview: fills the article's working column (wider than the text measure),
     sitting just under the author byline. */
  .chart-image { margin: 0 0 var(--space-5); max-width: var(--chart-max); }
  .chart-image img {
    width: 100%; height: auto; display: block;
    border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .chart-image figcaption { font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-2); }
  @media print { .chart-image { display: none; } }
</style>
