---
import '../styles/tokens.css'
import { getVariant } from '../lib/variant-config'
import { getCollection } from 'astro:content'
import { isHubLive } from '../lib/hub'
import ConsentBanner from '../components/ConsentBanner.astro'

/** Minimal valid JSON-LD: must carry @context and @type. */
export interface JsonLd {
  '@context': string | object
  '@type': string
  [key: string]: unknown
}

export interface Props {
  title: string
  description: string
  canonical?: string
  /** Path or URL to the social-share image. */
  ogImage?: string
  /** Structured data rendered into a <script type="application/ld+json">. */
  jsonLd?: JsonLd
}

const { title, description, canonical, ogImage, jsonLd } = Astro.props

// The active variant drives BOTH the theme token-set (data-theme) and the
// metrics tag (data-variant). One source of truth: getVariant().
const variant = getVariant()
const theme = variant

// Canonical: prefer the explicit prop, else derive from the configured site.
const canonicalUrl =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href)

// Social share image. Every page gets an auto-generated 1200×630 card at
// /og/<key>.png (see src/pages/og/[...route].ts); the key derives from the path
// ('home' for root). An explicit ogImage prop overrides it. So links always unfurl.
const ogKey = (() => {
  const p = Astro.url.pathname.replace(/^\/+|\/+$/g, '')
  return p === '' ? 'home' : p
})()
const autoOgUrl = Astro.site
  ? new URL(`/og/${ogKey}.png`, Astro.site).href
  : `/og/${ogKey}.png`

const ogImageUrl =
  ogImage === undefined
    ? autoOgUrl
    : /^https?:\/\//.test(ogImage)
      ? ogImage
      : Astro.site
        ? new URL(ogImage, Astro.site).href
        : new URL(ogImage, Astro.url).href

// Only emit JSON-LD when it carries the required shape; escape `<` so values
// containing `</script>` (or any markup) can't break out of the script tag.
const hasValidJsonLd = Boolean(jsonLd && jsonLd['@context'] && jsonLd['@type'])
const jsonLdSafe = hasValidJsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : ''

// GA4 is inert unless a measurement ID is configured at build time.
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined

// gtag bootstrap + Consent Mode v2 (default DENIED; honor a stored 'granted').
// Built as a string and emitted via set:html so the literal JS (braces, etc.) is
// written verbatim — NOT parsed as Astro/JSX, and NOT trapped in a dead template
// literal the way `define:vars` children would be.
// Owner self-exclusion: visiting `?sc_notrack=1` flags this device (any network/IP)
// to send NO analytics; `?sc_notrack=0` clears it. Wrapped in an IIFE so the flag
// check can early-return before any hit is sent.
const gaInit = ga4Id
  ? [
      '(function(){',
      'try{var _u=new URL(location.href);if(_u.searchParams.has("sc_notrack")){var _v=_u.searchParams.get("sc_notrack");if(_v==="0"||_v==="false"){localStorage.removeItem("sc_notrack")}else{localStorage.setItem("sc_notrack","1")}}}catch(e){}',
      'try{if(localStorage.getItem("sc_notrack")==="1")return}catch(e){}',
      'window.dataLayer = window.dataLayer || [];',
      'function gtag(){window.dataLayer.push(arguments);}',
      'window.gtag = gtag;',
      "gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});",
      "try{if(localStorage.getItem('sc_consent')==='granted')gtag('consent','update',{analytics_storage:'granted'});}catch(e){}",
      'gtag("js", new Date());',
      `gtag('config', ${JSON.stringify(ga4Id)});`,
      '})();',
    ].join('\n')
  : ''

// Active-nav detection: normalise the current path (strip trailing slash, treat
// empty as "/") so "/chores-for-a-6-year-old" and ".../" both match their link.
const normalisePath = (p: string) => {
  const trimmed = p.replace(/\/+$/, '')
  return trimmed === '' ? '/' : trimmed
}
const currentPath = normalisePath(Astro.url.pathname)
// Only surface the "Chore Charts" hub link when the hub is actually live (a real
// directory). Until then nav stays Home-only — no link to a suppressed/thin hub.
const allPages = await getCollection('pages')
const choreHubLive = isHubLive(allPages, 'chore-charts-by-age')
const navLinks = [
  { href: '/', label: 'Home' },
  ...(choreHubLive ? [{ href: '/chore-charts-by-age/', label: 'Chore Charts' }] : []),
  { href: '/about/', label: 'About' },
] as const
const isActive = (href: string) => normalisePath(href) === currentPath
---

<!doctype html>
<html lang="en" data-theme={theme} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {/* Pinterest domain claim verification */}
    <meta name="p:domain_verify" content="e20043296ab765dca7383ef1f809486b" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SproutChores" />
    <meta property="og:locale" content="en_US" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {/* JSON-LD: only when valid; `<` escaped so values can't close the tag. */}
    {hasValidJsonLd && (
      <script type="application/ld+json" set:html={jsonLdSafe} />
    )}

    {/* GA4 (gtag) — emitted ONLY when PUBLIC_GA4_ID is set. Absent => no script. */}
    {ga4Id && (
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
      />
    )}
    {ga4Id && <script is:inline set:html={gaInit} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="SproutChores — home">
          <svg
            class="brand__mark"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            aria-hidden="true"
            focusable="false"
            fill="none"
          >
            {/* Sprout: a stem rising from soil with two unfurling leaves. */}
            <path
              d="M12 21v-7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M12 14c0-3 2.4-5.4 5.4-5.4 0 3-2.4 5.4-5.4 5.4Z"
              fill="currentColor"
            />
            <path
              d="M12 12.5C12 9.9 9.9 7.8 7.2 7.8c0 2.7 2.1 4.7 4.8 4.7Z"
              fill="currentColor"
              opacity="0.7"
            />
          </svg>
          <span class="brand__word">SproutChores</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul class="site-nav__list" role="list">
            {navLinks.map((link) => (
              <li>
                <a
                  class="site-nav__link"
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <a class="brand brand--footer" href="/" aria-label="SproutChores — home">
          <svg
            class="brand__mark"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            aria-hidden="true"
            focusable="false"
            fill="none"
          >
            <path
              d="M12 21v-7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <path
              d="M12 14c0-3 2.4-5.4 5.4-5.4 0 3-2.4 5.4-5.4 5.4Z"
              fill="currentColor"
            />
            <path
              d="M12 12.5C12 9.9 9.9 7.8 7.2 7.8c0 2.7 2.1 4.7 4.8 4.7Z"
              fill="currentColor"
              opacity="0.7"
            />
          </svg>
          <span class="brand__word">SproutChores</span>
        </a>

        <p class="site-footer__tagline">
          Free, printable chore charts and routines for families.
        </p>

        <nav class="site-footer__links" aria-label="Footer">
          <a href="/printables/">All printables</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/disclosure/">Disclosure</a>
        </nav>

        <p class="site-footer__copy">
          © {new Date().getFullYear()} SproutChores. All rights reserved.
        </p>
      </div>
    </footer>

    <ConsentBanner />

    {/* web-vitals: report LCP / INP / CLS via the variant-tagged metrics client.
        Bundled (not is:inline) so the import is resolved & tree-shaken by Vite. */}
    <script>
      import { onLCP, onINP, onCLS, type Metric } from 'web-vitals'
      import { createMetrics } from '../lib/metrics'
      import { gaSend } from '../lib/metrics'
      import { getVariant } from '../lib/variant-config'

      const metrics = createMetrics({
        send: gaSend(import.meta.env.PUBLIC_GA4_ID),
        getVariant,
      })

      const report = (name: string) => (m: Metric) => {
        const precision = name === 'CLS' ? 1000 : 1
        const value = Math.round(m.value * precision) / precision
        metrics.track('web_vital', {
          metric: name,
          value,
          rating: m.rating,
          id: m.id,
        })
      }

      // Honor the owner self-exclusion flag (?sc_notrack=1) — skip web-vitals too.
      let _notrack = false
      try { _notrack = localStorage.getItem('sc_notrack') === '1' } catch (e) {}
      if (!_notrack) {
        onLCP(report('LCP'))
        onINP(report('INP'))
        onCLS(report('CLS'))
      }
    </script>

    <style>
      /* ---- Typographic baseline & reset — TOKENS ONLY ---- */
      :global(*),
      :global(*::before),
      :global(*::after) {
        box-sizing: border-box;
      }

      :global(html) {
        font-family: var(--font-sans);
        font-size: 100%;
        line-height: var(--leading-normal);
        color: var(--color-text);
        background-color: var(--color-bg);
        -webkit-text-size-adjust: 100%;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      :global(body) {
        margin: var(--space-0);
        min-height: 100vh;
        font-size: var(--text-base);
      }

      :global(main) {
        display: block;
      }

      /* Headings — logical scale, display face, tight leading. */
      :global(h1),
      :global(h2),
      :global(h3),
      :global(h4) {
        font-family: var(--font-display);
        line-height: var(--leading-tight);
        font-weight: var(--weight-bold);
        color: var(--color-text);
        margin-block: var(--space-0) var(--space-4);
        text-wrap: balance;
      }
      :global(h1) { font-size: var(--text-4xl); letter-spacing: -0.02em; }
      :global(h2) { font-size: var(--text-2xl); letter-spacing: -0.01em; }
      :global(h3) { font-size: var(--text-xl); }
      :global(h4) { font-size: var(--text-lg); }

      :global(p),
      :global(ul),
      :global(ol) {
        margin-block: var(--space-0) var(--space-4);
        max-width: var(--measure);
      }

      :global(a) {
        color: var(--color-primary);
        text-decoration-color: var(--color-border);
        text-underline-offset: var(--space-1);
        transition: color var(--duration-fast) var(--ease-out);
      }
      :global(a:hover) {
        color: var(--color-primary-hover);
        text-decoration-color: currentColor;
      }

      :global(strong) { font-weight: var(--weight-bold); }
      :global(small) { font-size: var(--text-sm); color: var(--color-muted); }

      /* Visible, token-driven focus ring on every interactive element. */
      :global(a:focus-visible),
      :global(button:focus-visible),
      :global(input:focus-visible),
      :global(select:focus-visible),
      :global(textarea:focus-visible),
      :global([tabindex]:focus-visible) {
        outline: var(--focus-ring-width) solid var(--focus-ring-color);
        outline-offset: var(--focus-ring-offset);
        border-radius: var(--radius-sm);
      }

      /* Accessible skip link — hidden until focused. */
      .skip-link {
        position: absolute;
        left: var(--space-3);
        top: calc(var(--space-3) * -10);
        z-index: 100;
        padding: var(--space-2) var(--space-4);
        background: var(--color-surface);
        color: var(--color-primary);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
        font-weight: var(--weight-medium);
        transition: top var(--duration-base) var(--ease-out);
      }
      .skip-link:focus {
        top: var(--space-3);
      }

      /* ---- Site chrome: header / brand / nav / footer (TOKENS ONLY) ---- */

      /* Shared inner container — same max-width + gutter as page content. */
      .site-header__inner,
      .site-footer__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        padding-inline: var(--space-5);
      }

      .site-header {
        background-color: var(--color-surface);
        border-bottom: var(--border-width) solid var(--color-border);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-5);
        padding-block: var(--space-4);
      }

      /* Brand: sprout glyph + wordmark. */
      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        color: var(--color-text);
        transition: color var(--duration-fast) var(--ease-out);
      }
      .brand:hover {
        color: var(--color-primary);
      }
      .brand__mark {
        flex-shrink: 0;
        color: var(--color-primary);
      }
      .brand__word {
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: var(--weight-bold);
        letter-spacing: -0.01em;
        line-height: var(--leading-tight);
      }

      /* Primary nav. */
      .site-nav__list {
        list-style: none;
        margin: var(--space-0);
        padding: var(--space-0);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
      }
      .site-nav__link {
        display: inline-flex;
        align-items: center;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-pill);
        font-size: var(--text-base);
        font-weight: var(--weight-medium);
        color: var(--color-muted);
        text-decoration: none;
        transition:
          color var(--duration-fast) var(--ease-out),
          background-color var(--duration-fast) var(--ease-out);
      }
      .site-nav__link:hover {
        color: var(--color-primary);
        background-color: var(--color-surface-sunken);
      }
      /* Active page — subtle sprout-tinted pill. */
      .site-nav__link[aria-current='page'] {
        color: var(--color-primary);
        background-color: var(--color-primary-soft);
        font-weight: var(--weight-bold);
      }

      /* ---- Footer ---- */
      .site-footer {
        margin-top: var(--space-8);
        background-color: var(--color-surface-sunken);
        border-top: var(--border-width) solid var(--color-border);
      }
      .site-footer__inner {
        display: grid;
        justify-items: center;
        text-align: center;
        gap: var(--space-3);
        padding-block: var(--space-7);
      }
      .brand--footer .brand__word {
        font-size: var(--text-lg);
      }
      .site-footer__tagline {
        margin: var(--space-0);
        max-width: var(--measure);
        color: var(--color-muted);
      }
      .site-footer__links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-4);
      }
      .site-footer__links a {
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        text-decoration: none;
        color: var(--color-primary);
      }
      .site-footer__links a:hover {
        color: var(--color-primary-hover);
        text-decoration: underline;
        text-underline-offset: var(--space-1);
      }
      .site-footer__copy {
        margin: var(--space-0);
        font-size: var(--text-xs);
        color: var(--color-muted);
      }

      /* Respect reduced-motion preferences. */
      @media (prefers-reduced-motion: reduce) {
        :global(*),
        :global(*::before),
        :global(*::after) {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
