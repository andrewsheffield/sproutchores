---
// TEMPORARY SCAFFOLDING — theme comparison preview.
// Renders the live chore-page content under the `sprout` skin so we can compare
// directions side by side. noindex + excluded from the sitemap (see
// astro.config.mjs). DELETE this whole src/pages/preview/ folder once a
// direction is picked.
import BaseLayout from '../../layouts/BaseLayout.astro'
import ChoreChartGenerator from '../../components/ChoreChartGenerator.astro'
import { bandForAge } from '../../data/chores-by-age'
import '../../styles/print.css'

const band67 = bandForAge(6)
const THEME = 'playful'
---

<BaseLayout
  title="Theme preview — Playful"
  description="Internal theme comparison preview (playful direction)."
  theme={THEME}
  noindex
>
  <div class="page-wrapper">
    <header class="page-header">
      <p class="preview-badge">Preview · {THEME}</p>
      <h1 class="page-title">Chore Chart for a 6-Year-Old</h1>
      <p class="page-intro">
        Six is a brilliant age to start building real responsibility. Use the
        generator below to make a personalised, printable chore chart in under a
        minute — no account, no fuss.
      </p>
    </header>

    <div class="generator-wrap">
      <ChoreChartGenerator />
    </div>

    <section class="content-section" aria-labelledby="why-chores-heading">
      <h2 id="why-chores-heading">Why chores matter at age 6</h2>
      <p>
        Around their sixth birthday, most children have the motor skills and
        attention span to complete simple household tasks from start to finish.
        Children who do regular chores develop stronger executive function and a
        greater sense of belonging in the family.
      </p>
      <ul class="chore-checklist" role="list">
        {band67.chores.map((chore) => (
          <li class="chore-checklist__item">
            <span class="chore-checklist__label">{chore.label}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
    padding-block: var(--space-7);
    display: grid;
    gap: var(--space-8);
  }
  .page-header {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .preview-badge {
    align-self: start;
    margin: var(--space-0);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-soft);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .page-title {
    margin-block: var(--space-0);
  }
  .page-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-block: var(--space-0);
  }
  .content-section {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .chore-checklist {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-2);
  }
  .chore-checklist__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .chore-checklist__item::before {
    content: '';
    display: block;
    width: var(--space-5);
    height: var(--space-5);
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-soft);
  }
  .chore-checklist__label {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
</style>
