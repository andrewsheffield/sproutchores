---
import BaseLayout from '../layouts/BaseLayout.astro'
import ChoreChartGenerator from '../components/ChoreChartGenerator.astro'
import { bandForAge } from '../data/chores-by-age'
import { isPublished } from '../lib/publish-gate'
import '../styles/print.css'

// Publish gate — set a past date to make this page live now.
// The scheduled-publish GitHub Actions workflow (scheduled-publish.yml) runs
// `astro build` on a daily cron; any page whose publishDate is in the future
// is excluded from that build. When the cron date reaches publishDate the next
// build flips it live automatically — no human intervention needed.
const publishDate = '2026-06-01'

// Chores for the 6-7 age band, sourced directly from the dataset.
const band67 = bandForAge(6)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Set Up a Chore Chart for a 6-Year-Old',
  description:
    'A step-by-step guide to creating a printable chore chart for a 6-year-old, ' +
    'with age-appropriate tasks that build responsibility and independence.',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Pick age-appropriate chores',
      text: 'Choose tasks your 6-year-old can do independently, such as making the bed, setting the table, and feeding a pet.',
    },
    {
      '@type': 'HowToStep',
      name: 'Enter your child\'s name and age',
      text: 'Type your child\'s name in the generator above to personalise the chart title.',
    },
    {
      '@type': 'HowToStep',
      name: 'Customise the chore list',
      text: 'Add or remove chores until the chart matches your household routine.',
    },
    {
      '@type': 'HowToStep',
      name: 'Print or save as PDF',
      text: 'Click "Print / Save as PDF" to get a clean, printer-ready chart with a box to tick for each day of the week.',
    },
  ],
  tool: [{ '@type': 'HowToTool', name: 'SproutChores printable chore-chart generator' }],
}
---

{isPublished(publishDate) ? (
<BaseLayout
  title="Chore Chart for a 6-Year-Old (Free Printable)"
  description="Make a free printable chore chart for your 6-year-old in seconds. Pick age-appropriate tasks, add your child's name, and print or save as PDF — no sign-up needed."
  jsonLd={jsonLd}
>
  <div class="page-wrapper">

    <!-- ── Page header ─────────────────────────────────────────────────── -->
    <header class="page-header">
      <h1 class="page-title">Chore Chart for a 6-Year-Old</h1>
      <p class="page-intro">
        Six is a brilliant age to start building real responsibility.
        Use the generator below to make a personalised, printable chore chart
        in under a minute — no account, no fuss.
      </p>
    </header>

    <!-- ── Generator island — above the fold ───────────────────────────── -->
    <div class="generator-wrap">
      <ChoreChartGenerator />
    </div>

    <!-- ── Supporting content ──────────────────────────────────────────── -->
    <section class="content-section" aria-labelledby="why-chores-heading">
      <h2 id="why-chores-heading">Why chores matter at age 6</h2>
      <p>
        Around their sixth birthday, most children have the motor skills and
        attention span to complete simple household tasks from start to finish —
        without a grown-up finishing it for them. Research on child development
        consistently shows that children who do regular chores develop stronger
        executive function, a greater sense of belonging in the family, and
        better self-regulation skills later in life.
      </p>
      <p>
        The key is to match the chore to what the child can actually do today,
        then step back and let them own it — even if the bed isn't perfectly
        straight. Mastery and pride in a job done matter far more than
        perfection.
      </p>
    </section>

    <section class="content-section" aria-labelledby="age-chores-heading">
      <h2 id="age-chores-heading">Age-appropriate chores for a 6-year-old</h2>
      <p>
        The chores below are pre-loaded in the generator above. Every one of
        them is something a typical 6- or 7-year-old can manage independently
        with a little initial guidance:
      </p>

      <ul class="chore-checklist" role="list">
        {band67.chores.map((chore) => (
          <li class="chore-checklist__item">
            <span class="chore-checklist__label">{chore.label}</span>
          </li>
        ))}
      </ul>

      <p>
        <strong>Make the bed</strong> and <strong>tidy bedroom</strong> teach
        ownership of personal space — two minutes each morning that build a
        life-long habit. <strong>Set the table</strong> and
        <strong>feed a pet</strong> give children a meaningful role in caring
        for others, which research links to greater empathy.
        <strong>Water the plants</strong> and
        <strong>sort laundry by color</strong> develop patience and an eye
        for pattern — cognitive skills that transfer well into schoolwork.
      </p>
    </section>

    <section class="content-section" aria-labelledby="tips-heading">
      <h2 id="tips-heading">Tips for making chores stick</h2>
      <ul class="tips-list">
        <li>
          <strong>Do it together the first few times.</strong>
          Demonstration beats instruction every time at this age.
        </li>
        <li>
          <strong>Put the chart where it's visible.</strong>
          Print it out and stick it on the fridge or bedroom door — not a
          buried bookmark.
        </li>
        <li>
          <strong>Tick the boxes together each evening.</strong>
          The ritual of checking off tasks is motivating in itself.
        </li>
        <li>
          <strong>Adjust the list as skills grow.</strong>
          The generator lets you swap chores any time. By age 7 or 8, most
          children are ready to load the dishwasher or take out the bins.
        </li>
      </ul>
    </section>

  </div>
</BaseLayout>
) : (
  <!-- Future-dated: page is not yet live. The scheduled-publish cron will
       flip this live once publishDate is in the past. Until then, serve
       a minimal no-index placeholder so the URL returns 200 without
       leaking draft content to search engines. -->
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="robots" content="noindex, nofollow" />
      <title>Coming soon</title>
    </head>
    <body></body>
  </html>
)}

<style>
  /* ── Page layout — tokens only; no hardcoded hex / rgb / px ─────────── */

  .page-wrapper {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
    padding-block: var(--space-7);
    display: grid;
    gap: var(--space-8);
  }

  /* ── Header ─────────────────────────────────────────────────────────── */

  .page-header {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .page-title {
    /* h1 styles come from BaseLayout's global typographic baseline */
    margin-block: var(--space-0);
  }

  .page-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-block: var(--space-0);
  }

  /* ── Generator wrapper ───────────────────────────────────────────────── */

  .generator-wrap {
    /* No extra chrome — the generator island has its own surface/shadow */
  }

  /* ── Content sections ────────────────────────────────────────────────── */

  .content-section {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  /* ── Chore checklist ─────────────────────────────────────────────────── */

  .chore-checklist {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-2);
  }

  .chore-checklist__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }

  .chore-checklist__item::before {
    content: '';
    display: block;
    width: var(--space-5);
    height: var(--space-5);
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-soft);
  }

  .chore-checklist__label {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /* ── Tips list ───────────────────────────────────────────────────────── */

  .tips-list {
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }

  .tips-list li {
    line-height: var(--leading-normal);
    color: var(--color-text);
  }
</style>
