---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="SproutChores — Free Printable Chore Charts for Kids"
  description="Make free printable chore charts for children of any age. Pick the right tasks, add your child's name, and print or save as PDF in seconds."
>
  <div class="home-wrapper">
    <header class="home-header">
      <h1 class="home-title">SproutChores</h1>
      <p class="home-tagline">
        Free, printable chore charts that grow with your child.
      </p>
    </header>

    <nav class="home-nav" aria-label="Chore chart pages">
      <ul class="home-nav__list" role="list">
        <li>
          <a class="home-nav__link" href="/chores-for-a-6-year-old/">
            Chore Chart for a 6-Year-Old
          </a>
        </li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .home-wrapper {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
    padding-block: var(--space-8);
    display: grid;
    gap: var(--space-7);
  }

  .home-header {
    display: grid;
    gap: var(--space-3);
  }

  .home-title {
    margin-block: var(--space-0);
  }

  .home-tagline {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-block: var(--space-0);
    max-width: var(--measure);
  }

  .home-nav__list {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-3);
  }

  .home-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    text-decoration-color: var(--color-border);
    text-underline-offset: var(--space-1);
  }

  .home-nav__link:hover {
    color: var(--color-primary-hover);
    text-decoration-color: currentColor;
  }
</style>
