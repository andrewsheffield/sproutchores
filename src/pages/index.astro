---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import EmailSignup from '../components/EmailSignup.astro'
import { author } from '../data/author'
import ChartCard from '../components/ChartCard.astro'
import { isPublished } from '../lib/publish-gate'
import { isHubLive } from '../lib/hub'
import { chartEligible } from '../lib/chart-image'
import { homeRows, featuredCards } from '../lib/home-rows'

const HERO_CHART = 'chore-chart-for-a-6-year-old'

const all = await getCollection('pages')
// Same liveness rule as the rest of the site; normalize to the home-rows shape.
const live = all
  .filter((e) => (e.data.type === 'category' ? isHubLive(all, e.id) : isPublished(e.data.publish_date)))
  .map((e) => ({
    id: e.id,
    h1: e.data.h1,
    type: e.data.type,
    category: e.data.category ?? null,
    priority: e.data.priority,
    age: e.data.age,
    hasImage: chartEligible(e.data),
  }))

const rows = homeRows(live)
const featured = featuredCards(live)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SproutChores',
  url: 'https://sproutchores.com',
  description: 'Free printable chore charts for kids of any age — pick age-appropriate tasks, personalize, and print or save as PDF.',
}
---
<BaseLayout
  title="SproutChores — Free Printable Chore Charts for Kids"
  description="Make a free printable chore chart for your child in under a minute. Pick age-appropriate tasks, add their name, and print or save as PDF — no sign-up."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title">Free printable chore charts that grow with your kid</h1>
        <p class="hero__lede">Pick the right tasks for your child's age, personalize, and print or save as a PDF — in under a minute, no account.</p>
        <div class="hero__cta">
          <a class="btn btn--solid" href={`/${HERO_CHART}/`}>Make a chart →</a>
          <a class="btn btn--ghost" href="/chore-charts-by-age/">Browse by age</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <img class="hero__art-chart" src={`/charts/${HERO_CHART}.png`} alt="" width="1650" height="1275" loading="eager" decoding="async" />
        <img class="hero__art-illus" src="/images/scene-family-chores.jpg" alt="" width="1200" height="960" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="strip">
      <h2 class="strip__heading">Most-loved printables</h2>
      <div class="cardgrid">
        {featured.map((c) => <ChartCard slug={c.slug} title={c.title} label={c.label} categoryId={c.categoryId} hasImage={c.hasImage} />)}
      </div>
    </section>
  )}

  {rows.map((row) => (
    <section class="row">
      <div class="row__head">
        <h2 class="row__heading" style={`--ink:${row.color.ink}`}><a href={`/${row.slug}/`}>{row.title}</a></h2>
        <a class="row__all" href={`/${row.slug}/`}>See all →</a>
      </div>
      <div class="cardgrid">
        {row.cards.map((c) => <ChartCard slug={c.slug} title={c.title} label={c.label} categoryId={c.categoryId} hasImage={c.hasImage} />)}
      </div>
    </section>
  ))}

  <section class="meet">
    <img class="meet__art" src={author.image} alt={author.imageAlt} width="750" height="1000" loading="lazy" decoding="async" />
    <div class="meet__copy">
      <h2 class="meet__heading">Meet the family behind the charts</h2>
      <p>We're Andrew and the SproutChores family — foster parents of four, a veteran dad and a homeschooling mom. Every chart and tip here comes from what's actually worked (and flopped) in our own home.</p>
      <a class="meet__cta" href="/about/">Our story →</a>
    </div>
  </section>

  <div class="home-signup"><EmailSignup /></div>
</BaseLayout>

<style>
  /* Hero — split, vibrant gradient + scrim for legible white text. */
  .hero {
    /* Full-bleed gradient; the CONTENT is constrained by .hero__inner so it never
       sprawls to unreadable line lengths on wide displays. */
    background-image: linear-gradient(var(--hero-scrim), var(--hero-scrim)), var(--hero-gradient);
    color: #fff;
  }
  .hero__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-5);
  }
  /* Explicit white — the global `:global(h1){color:var(--color-text)}` (dark) in
     BaseLayout targets the h1 directly and would otherwise override the hero's
     inherited white, rendering the headline near-black on the gradient. */
  .hero__title { margin: var(--space-0); text-wrap: balance; font-size: var(--text-4xl); color: #fff; }
  .hero__lede { font-size: var(--text-lg); line-height: var(--leading-normal); margin: var(--space-4) 0 var(--space-5); color: rgba(255,255,255,.92); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .btn { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-5); border-radius: var(--radius-md); font-weight: var(--weight-bold); font-size: var(--text-lg); text-decoration: none; }
  .btn--solid { background: #fff; color: var(--cat-age-ink); box-shadow: var(--shadow-sm); }
  .btn--ghost { background: rgba(255,255,255,.14); color: #fff; border: 2px solid rgba(255,255,255,.7); }
  .btn:focus-visible { outline: none; box-shadow: 0 0 0 var(--focus-ring-width) #fff; }
  /* Hero "stack": tilted chart as the back card + a smaller illustration card
     overlapping its lower-right corner, rotated the other way (photo-stack look). */
  .hero__art { position: relative; padding-bottom: var(--space-7); }
  .hero__art-chart { display: block; width: 100%; height: auto; border-radius: var(--radius-md); box-shadow: var(--shadow-md); transform: rotate(-3deg); }
  .hero__art-illus {
    position: absolute; right: 2%; bottom: 0;
    width: 46%; height: auto;
    border-radius: var(--radius-md);
    border: 5px solid #fff;
    box-shadow: var(--shadow-md);
    transform: rotate(5deg);
  }

  /* Shared content width + card grid */
  .strip, .row { max-width: var(--container-max); margin-inline: auto; padding: var(--space-7) var(--space-5) var(--space-0); display: grid; gap: var(--space-4); }
  .strip__heading { margin: var(--space-0); color: var(--cat-highlight-ink); }
  .row__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3); }
  .row__heading { margin: var(--space-0); }
  .row__heading a { color: var(--ink); text-decoration: none; }
  .row__all { font-weight: var(--weight-medium); white-space: nowrap; }
  .cardgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: var(--space-4); }

  .home-signup { max-width: var(--measure); margin-inline: auto; padding: var(--space-8) var(--space-5); }

  .meet { max-width: var(--container-max); margin-inline: auto; padding: var(--space-7) var(--space-5) var(--space-0); display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--space-6); }
  .meet__art { width: 9rem; height: 12rem; object-fit: cover; object-position: top; border-radius: var(--radius-md); box-shadow: var(--shadow-md); }
  .meet__heading { margin: var(--space-0) 0 var(--space-3); }
  .meet__copy p { margin: var(--space-0) 0 var(--space-4); color: var(--color-text); line-height: var(--leading-normal); }
  .meet__cta { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-5); border-radius: var(--radius-md); background: var(--cat-age-ink); color: #fff; font-weight: var(--weight-bold); text-decoration: none; }
  .meet__cta:focus-visible { outline: none; box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring-color); }
  @media (max-width: 40rem) { .meet { grid-template-columns: 1fr; } .meet__art { width: 7rem; height: 9.3rem; } }

  @media (max-width: 48rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__title { font-size: var(--text-3xl); }
  }
  @media (max-width: 30rem) {
    .hero__art { display: none; }
    .strip, .row { padding-inline: var(--space-3); }
    .home-signup { padding-inline: var(--space-3); }
  }
</style>
