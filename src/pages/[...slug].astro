---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ChoreChartGenerator from '../components/ChoreChartGenerator.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import EmbedChart from '../components/EmbedChart.astro'
import TableOfContents from '../components/TableOfContents.astro'
import EmailSignup from '../components/EmailSignup.astro'
import ChartImage from '../components/ChartImage.astro'
import { chartEligible } from '../lib/chart-image'
import RecommendedGear from '../components/RecommendedGear.astro'
import AdSlot from '../components/AdSlot.astro'
import { gearForPage } from '../lib/affiliate'
import { bandForAge } from '../data/chores-by-age'
import { isPublished } from '../lib/publish-gate'
import { isHubLive } from '../lib/hub'
import { author } from '../data/author'
import '../styles/print.css'

// One static path per PUBLISHED age page, plus category hubs that are "live" —
// published AND aggregating enough member pages (isHubLive). A hub with too few
// members is suppressed (thin/intent-missing) and self-restores once the cluster
// fills. Future-dated entries are excluded; the scheduled cron flips them live.
export async function getStaticPaths() {
  const all = await getCollection('pages')
  return all
    .filter((e) => {
      if (e.data.type === 'age') return isPublished(e.data.publish_date)
      if (e.data.type === 'guide') return isPublished(e.data.publish_date)
      if (e.data.type === 'category') return isHubLive(all, e.id)
      return false
    })
    .map((e) => ({ params: { slug: e.id }, props: { entry: e, all } }))
}

const { entry, all } = Astro.props
const d = entry.data
const isHub = d.type === 'category'

// Generator: age pages use the default 'chore' variant; other pages may set a
// generator_variant (money/routine/reward). Show it for any non-hub page that
// either has an age (age-based) or declares a variant.
const genVariant = d.generator_variant ?? 'chore'
const showGenerator = !isHub && (typeof d.age === 'number' || d.generator_variant != null)

// Dataset-driven chore list for the static (SEO / no-JS) render — age pages only.
const band = d.type === 'age' && typeof d.age === 'number' ? bandForAge(d.age) : undefined

// First sentence of a longer intro — a tidy teaser for the hub directory list.
function firstSentence(text) {
  const m = (text || '').match(/^.*?[.!?](\s|$)/)
  return (m ? m[0] : text || '').trim()
}

// Hub: the member pages are every PUBLISHED entry whose category is this hub,
// ordered by age. Computed at render time so the ladder fills in as pages publish.
const members = isHub
  ? all
      .filter((e) => e.data.category === entry.id && isPublished(e.data.publish_date))
      .sort((a, b) => (a.data.age ?? 999) - (b.data.age ?? 999))
      .map((e) => ({ slug: e.id, h1: e.data.h1, blurb: firstSentence(e.data.intro), age: e.data.age, type: e.data.type }))
  : []

// §2: compact "pick your age" grid for the hub, surfaced high so the dominant
// (navigational) intent is satisfied in one glance. Only true age pages (not
// guides that happen to carry an age), and one pill per age (no duplicate labels).
const ageGrid = isHub
  ? members
      .filter((m) => m.type === 'age' && typeof m.age === 'number')
      .filter((m, i, arr) => arr.findIndex((x) => x.age === m.age) === i)
      .map((m) => ({ slug: m.slug, label: String(m.age) }))
  : []

// Decorative illustration per page: hubs (no chart hero) get a top banner; chart
// pages get a warm inset below the intro, only where a specific scene fits.
const pageIllus = (() => {
  if (isHub) {
    if (entry.id === 'chore-charts-by-age') return { src: '/images/cat-by-age.jpg', alt: 'Illustration of children of different ages doing chores' }
    if (entry.id === 'behavior-charts-for-kids') return { src: '/images/scene-calm-moment.jpg', alt: 'Illustration of a parent calmly reassuring a child' }
    return null
  }
  if (d.category === 'chore-chart-for-adhd' || /adhd/.test(entry.id)) return { src: '/images/scene-calm-moment.jpg', alt: 'Illustration of a parent calmly reassuring a child' }
  if (d.category === 'cleaning-schedules') return { src: '/images/cat-cleaning.jpg', alt: "Illustration of a freshly tidied, organized kids' room" }
  if (typeof d.age === 'number' && d.age <= 3) return { src: '/images/scene-toddler-helping.jpg', alt: 'Illustration of a toddler proudly helping with chores' }
  if (/teen/.test(entry.id) || (typeof d.age === 'number' && d.age >= 13)) return { src: '/images/scene-teen.jpg', alt: 'Illustration of a teenager doing chores independently' }
  return null
})()

// Resolve related slugs → { slug, title } using the loaded collection.
const byId = new Map(all.map((e) => [e.id, e]))
const related = (d.related ?? [])
  .map((slug) => byId.get(slug))
  .filter((e) => e && isPublished(e.data.publish_date))
  .map((e) => ({ slug: e.id, title: e.data.h1 }))

// Resilient cross-linking: top up with other LIVE pages so every live page links
// to live neighbors NOW — even before its curated cluster siblings publish (and
// fixes pages with an empty `related`). Newest first; hubs excluded; cap ~3.
const relatedSlugs = new Set(related.map((r) => r.slug))
const isLiveOther = (e) =>
  e.id !== entry.id && e.data.type !== 'category' && !relatedSlugs.has(e.id) && isPublished(e.data.publish_date)
// Cluster-aware top-up: fill from SAME-category neighbors first (ranked by age
// proximity, like the curated related list), so a routine page links other routines
// and an age page links adjacent ages — then fall back to other live pages, newest
// first, so every page still links somewhere even before its cluster fills.
const ageGap = (e) =>
  typeof e.data.age === 'number' && typeof d.age === 'number' ? Math.abs(e.data.age - d.age) : 99
const sameCatOthers = all
  .filter((e) => isLiveOther(e) && e.data.category && e.data.category === d.category)
  .sort((a, b) => (ageGap(a) - ageGap(b)) || a.id.localeCompare(b.id))
const otherLive = all
  .filter((e) => isLiveOther(e) && !(e.data.category && e.data.category === d.category))
  .sort((a, b) => (b.data.publish_date ?? '').localeCompare(a.data.publish_date ?? ''))
const liveOthers = [...sameCatOthers, ...otherLive].map((e) => ({ slug: e.id, title: e.data.h1 }))
// §2: age pages always surface the allowance-by-age breakout (concentrate authority
// on the site's strongest page). Prepend it when live + not the current page.
const allowanceEntry = byId.get('allowance-for-kids-by-age')
const allowancePrepend =
  d.type === 'age' && entry.id !== 'allowance-for-kids-by-age' && allowanceEntry && isPublished(allowanceEntry.data.publish_date)
    ? [{ slug: 'allowance-for-kids-by-age', title: allowanceEntry.data.h1 }]
    : []
const relatedShown = [...allowancePrepend, ...related, ...liveOthers]
  .filter((r, i, arr) => arr.findIndex((x) => x.slug === r.slug) === i)
  .slice(0, 3)

// Table-of-contents jump links: the prose sections + FAQ (shown when ≥3 — handled
// in the component). IDs match the headings rendered below.
const tocItems = [
  ...d.sections.map((s, i) => ({ id: `section-${i}`, label: s.heading })),
  ...(d.faq.length ? [{ id: 'faq-heading', label: 'Frequently asked questions' }] : []),
]

// Split a section body into renderable blocks: a block whose lines all start
// with "- " becomes a <ul>; everything else is a paragraph. Lets generated
// content include scannable bullets without a full markdown dependency.
function renderBlocks(body) {
  return body.split('\n\n').map((block) => {
    const lines = block.split('\n').filter((l) => l.trim().length > 0)
    const isList = lines.length > 0 && lines.every((l) => l.trim().startsWith('- '))
    return isList
      ? { kind: 'list', items: lines.map((l) => l.replace(/^\s*-\s+/, '')) }
      : { kind: 'para', text: block }
  })
}

const site = Astro.site?.href.replace(/\/$/, '') ?? ''
const pageUrl = `${site}/${entry.id}/`

// Crawlable chart image (built to /charts/<slug>.png) — only for pages that show a chart.
const hasChartImage = chartEligible(d)
const chartImageUrl = `${site}/charts/${entry.id}.png`
const chartAlt = `Free printable ${d.target_keyword} — weekly chart with example marks filled in`

// --- JSON-LD: Article (carries author E-E-A-T) + FAQPage. ---
// (HowTo removed 2026-06-11: Google deprecated HowTo rich results in 2023, so the
// markup produced no rich result — dead weight. FAQ kept: valid + adds semantic context.)
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.meta_description,
  author: author.person,
  publisher: { '@type': 'Organization', name: 'SproutChores' },
  datePublished: d.publish_date,
  mainEntityOfPage: pageUrl,
  ...(hasChartImage
    ? { image: { '@type': 'ImageObject', url: chartImageUrl, width: 1650, height: 1275 } }
    : {}),
}

const faqJsonLd = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined

const faqSafe = faqJsonLd ? JSON.stringify(faqJsonLd).replace(/</g, '\\u003c') : ''

// Hub: CollectionPage + ItemList of the member pages (helps Google understand the
// hub→members relationship). Only emitted when there are published members.
const collectionJsonLd = isHub && members.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: d.title,
      description: d.meta_description,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: members.map((m, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${site}/${m.slug}/`,
          name: m.h1,
        })),
      },
    }
  : undefined
const collectionSafe = collectionJsonLd ? JSON.stringify(collectionJsonLd).replace(/</g, '\\u003c') : ''
---

<BaseLayout title={d.title} description={d.meta_description} jsonLd={articleJsonLd}>
  <div class="page-wrapper">

    <Breadcrumbs category={d.category} categoryLive={d.category ? isHubLive(all, d.category) : false} title={d.h1} />

    <header class="page-header">
      <h1 class="page-title">{d.h1}</h1>
      <p class="byline">{author.byline}</p>
    </header>

    {/* Hero: the printable preview, directly under the author byline, filling the article width. */}
    {hasChartImage && (
      <ChartImage slug={entry.id} alt={chartAlt} caption="A preview of the printable — customize + print your own below." />
    )}

    {isHub && ageGrid.length > 0 && (
      <nav class="age-grid" aria-label="Pick your child's age">
        <span class="age-grid__label">Jump to your child's age:</span>
        {ageGrid.map((a) => <a class="age-grid__item" href={`/${a.slug}/`}>{a.label}</a>)}
      </nav>
    )}

    {isHub && pageIllus && (
      <img class="page-illus" src={pageIllus.src} alt={pageIllus.alt} width="1200" height="960" loading="lazy" decoding="async" />
    )}

    <p class="page-intro">{d.intro}</p>

    {!isHub && pageIllus && (
      <img class="page-illus" src={pageIllus.src} alt={pageIllus.alt} width="1200" height="960" loading="lazy" decoding="async" />
    )}

    {showGenerator && (
      <div class="generator-wrap">
        <ChoreChartGenerator age={d.age} variant={genVariant} people={d.people} />
      </div>
    )}

    {/* Peak-intent email capture: someone who just built a chart is the most likely
        to want the whole Age-by-Age pack. Compact so it reads as a nudge, not a wall. */}
    {showGenerator && <EmailSignup id="pack-inline" compact={true} />}

    {isHub && (
      <section class="content-section" aria-labelledby="browse-heading">
        <h2 id="browse-heading">Find a chore chart for your child's age</h2>
        {members.length > 0 ? (
          <>
            <p>Pick an age to open a free, age-appropriate printable chart and generator:</p>
            <ul class="member-list" role="list">
              {members.map((m) => (
                <li class="member-list__item">
                  <a class="member-list__link" href={`/${m.slug}/`}>{m.h1}</a>
                  <p class="member-list__blurb">{m.blurb}</p>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p>More age-specific charts are publishing shortly — check back soon.</p>
        )}
      </section>
    )}

    {isHub && (
      <section class="content-section generator-cta" aria-labelledby="gen-heading">
        <h2 id="gen-heading">Or build one right now</h2>
        <p>Prefer to jump straight in? Set the age, tweak the chores, and print — no sign-up.</p>
        <div class="generator-wrap">
          <ChoreChartGenerator age={d.age} variant={d.generator_variant ?? 'chore'} people={d.people} />
        </div>
      </section>
    )}

    {/* Hub peak-intent capture: after the "build one right now" generator. */}
    {isHub && <EmailSignup id="pack-hub" compact={true} />}

    {band && (
      <section class="content-section" aria-labelledby="age-chores-heading">
        <h2 id="age-chores-heading">Age-appropriate chores for {d.h1.replace(/^Chore Chart for /i, '').replace(/\s*\(.*$/, '')}</h2>
        <p>Every chore below is pre-loaded in the generator above and is something a child in this age range can realistically manage with a little initial guidance:</p>
        <ul class="chore-checklist" role="list">
          {band.chores.map((chore) => (
            <li class="chore-checklist__item">
              <span class="chore-checklist__label">{chore.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {!isHub && <TableOfContents items={tocItems} />}

    {d.sections.map((section, i) => (
      <>
        <section class="content-section" aria-labelledby={`section-${i}`}>
          <h2 id={`section-${i}`}>{section.heading}</h2>
          {renderBlocks(section.body).map((block) =>
            block.kind === 'list' ? (
              <ul class="tips-list">{block.items.map((it) => <li>{it}</li>)}</ul>
            ) : (
              <p>{block.text}</p>
            )
          )}
        </section>
        {i === 0 && !isHub && <AdSlot id="mid" />}
      </>
    ))}

    {!isHub && <RecommendedGear productKeys={gearForPage(entry.id, d)} />}

    {d.faq.length > 0 && (
      <section class="content-section" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        <dl class="faq">
          {d.faq.map((f) => (
            <div class="faq__item">
              <dt class="faq__q">{f.q}</dt>
              <dd class="faq__a">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="author-card" aria-labelledby="author-heading">
      <div class="author-card__head">
        <img class="author-card__avatar" src={author.image} alt={author.imageAlt} width="750" height="1000" loading="lazy" decoding="async" />
        <h2 id="author-heading" class="author-card__name">About the author</h2>
      </div>
      {author.bioParagraphs.map((p) => <p class="author-card__bio">{p}</p>)}
    </section>

    {!isHub && relatedShown.length > 0 && (
      <section class="content-section" aria-labelledby="related-heading">
        <h2 id="related-heading">More free printables</h2>
        <ul class="related-list" role="list">
          {relatedShown.map((r) => (
            <li><a href={`/${r.slug}/`}>{r.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {!isHub && (
      <EmbedChart slug={entry.id} h1={d.h1} />
    )}

    <EmailSignup />

  </div>

  {faqJsonLd && <script type="application/ld+json" set:html={faqSafe} />}
  {collectionJsonLd && <script type="application/ld+json" set:html={collectionSafe} />}
</BaseLayout>

<style>
  .page-wrapper {
    /* Center the whole content column on the page (equal margins). Cap it at the
       widest element (the chart/generator = --chart-max) plus the side padding, so
       the centered container hugs the content instead of sprawling to 72rem and
       leaving a big right gap. */
    max-width: calc(var(--chart-max) + var(--space-5) * 2);
    margin-inline: auto;
    padding-inline: var(--space-5);
    padding-block: var(--space-7);
    display: grid;
    /* minmax(0,1fr) (not the default minmax(auto,1fr)) lets the single column
       shrink below its content, so a wide child (the chart) scrolls inside its
       own box instead of widening the whole page. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  /* Phone: tighter side gutters so the generator + content get more width. */
  @media (max-width: 30rem) {
    .page-wrapper {
      padding-inline: var(--space-3);
      gap: var(--space-6);
    }
  }

  .page-header {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }
  .page-title {
    margin-block: var(--space-0);
  }
  .byline {
    margin: var(--space-0);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
  }
  .page-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-normal);
    margin-block: var(--space-0);
    max-width: var(--measure);
  }

  .content-section {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  /* The generator/chart needs more width than the 68ch reading measure. Give it a
     dedicated column (left-aligned, shared edge with the prose) so the chart fits
     WITHOUT clipping the trailing remove button, and isn't so wide it dwarfs the
     prose (which made the text look "pushed left"). */
  .generator-wrap {
    max-width: var(--chart-max);
  }
  /* Hub "Or build one right now" wraps the generator inside a .content-section
     (capped at 68ch) — that cap was narrower than the chart's min-width and clipped
     the delete column. Widen this section to the chart column. */
  .generator-cta {
    max-width: var(--chart-max);
  }

  .chore-checklist {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-2);
  }
  .chore-checklist__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .chore-checklist__item::before {
    content: '';
    display: block;
    width: var(--space-5);
    height: var(--space-5);
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--radius-sm);
    background-color: var(--color-accent-soft);
  }
  .chore-checklist__label {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .tips-list {
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }
  .tips-list li {
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  /* FAQ */
  .faq {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-0);
  }
  .faq__item {
    display: grid;
    gap: var(--space-1);
  }
  .faq__q {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }
  .faq__a {
    margin: var(--space-0);
    color: var(--color-text);
    line-height: var(--leading-normal);
  }

  /* Author card — E-E-A-T credibility block */
  .author-card {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background-color: var(--color-surface-sunken);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .author-card__name {
    font-size: var(--text-lg);
    margin-block: var(--space-0);
  }
  .author-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .author-card__avatar {
    width: 6rem;
    height: 6rem;
    flex: 0 0 auto;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
  }
  .author-card__bio {
    margin: var(--space-0);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  /* Related links */
  .related-list {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-2);
  }
  .related-list a {
    font-weight: var(--weight-medium);
  }

  /* Hub member list — the age ladder */
  .member-list {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: grid;
    gap: var(--space-3);
  }
  .member-list__item {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .member-list__link {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }
  .member-list__blurb {
    margin: var(--space-0);
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  /* §2: compact age picker, high on the hub */
  .age-grid { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); max-width: var(--measure); }
  .age-grid__label { width: 100%; font-weight: var(--weight-medium); color: var(--color-muted); }
  .age-grid__item { display: inline-grid; place-items: center; min-width: 2.75rem; padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); font-weight: var(--weight-bold); text-decoration: none; color: var(--color-primary); }
  .age-grid__item:hover, .age-grid__item:focus-visible { background: var(--color-accent-soft); outline: none; }
  .page-illus { display: block; width: 100%; height: auto; max-width: var(--measure); border-radius: var(--radius-md); box-shadow: var(--shadow-md); margin-block: var(--space-5); }
</style>
