# Public, build-time site config (Astro exposes PUBLIC_* to the client).
# The GA4 Measurement ID is NOT a secret — it ships in every visitor's page
# source — so it's committed here to guarantee the tag is emitted in CI builds.
PUBLIC_GA4_ID=G-9R7L8S2T9F

# Public MailerLite form identifiers — they ship in page source (like PUBLIC_GA4_ID),
# so they're committed here. The secret API token stays in .secrets/ (gitignored).
PUBLIC_MAILERLITE_ACCOUNT=2426314
PUBLIC_MAILERLITE_FORM=190088912719316874
