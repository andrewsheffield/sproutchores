{
  "name": "sproutchores-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --import tsx/esm scripts/render-images.ts && node --import tsx/esm scripts/make-bundle.ts",
    "preview": "astro preview",
    "shots": "bash scripts/shots.sh",
    "shots:watch": "bash scripts/shots-watch.sh",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/lucide": "^1.2.111",
    "astro": "^6",
    "astro-icon": "^1.1.5",
    "astro-og-canvas": "^0.11.1",
    "web-vitals": "^5"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  }
}
